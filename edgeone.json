{
  "headers": [
    {
      "source": "/*",
      "headers": [
        {
          "key": "strict-transport-security",
          "value": "max-age=63072000; includeSubDomains"
        },
        {
          "key": "Cache-Control",
          "value": "max-age=600"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    }
  ]
}
