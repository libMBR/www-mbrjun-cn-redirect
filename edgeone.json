{
  "name": "www-mbrjun-cn-redirect",
 
  "redirects": [
    {
      "source": "/:path",
      "destination": "https://www.libmbr.com/:path",
      "statusCode": 301
    },
    {
      "source": "/",
      "destination": "https://www.libmbr.com/",
      "statusCode": 301
    }
  ],
  "headers": [
    {
      "source": "/*",
      "headers": [
        {
          "key": "strict-transport-security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "Cache-Control",
          "value": "max-age=31536000"
        }
      ]
    }
  ]
}
